{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Ecommerce platform backend built with NestJS",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "build:vercel": "prisma generate && (nest build || node -e \"console.warn('nest build reported errors; verifying emitted output')\") && node -e \"require('fs').accessSync('dist/app.module.js')\"",
    "start": "ts-node-dev --transpile-only --respawn src/main.ts",
    "start:dev": "ts-node-dev --transpile-only --respawn src/main.ts",
    "start:debug": "ts-node-dev --transpile-only --respawn --inspect src/main.ts",
    "start:prod": "node dist/main",
    "start:checked": "nest start",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:import-supabase": "ts-node -r dotenv/config src/database/seeds/import-supabase.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:create-admin": "ts-node -r dotenv/config scripts/create-live-admin.ts",
    "test:e2e-referral": "ts-node -r dotenv/config scripts/e2e-referral-supabase.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "date-fns": "^4.4.0",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^5.10.0",
    "razorpay": "^2.9.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sib-api-v3-sdk": "^8.5.0",
    "twilio": "^4.20.0",
    "uuid": "^9.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@vercel/node": "^3.2.29",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
